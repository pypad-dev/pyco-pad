{
  "name": "pyco-pad",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "postinstall": "cp node_modules/lms-widget-manager/dist/lms-widget-manager.iife.js public/",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "release": "node scripts/release.mjs",
    "assemble": "node scripts/assemble-site.mjs"
  },
  "devDependencies": {
    "jsdom": "^30.1.3",
    "lms-widget-manager": "github:pypad-dev/lms-widget-manager#v1.1.0",
    "typescript": "^5.2.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "fsevents@2.3.3": true,
    "lms-widget-manager": true
  }
}
